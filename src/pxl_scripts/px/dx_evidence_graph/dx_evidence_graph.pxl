def stack_trace(start_time: str, clickhouse_dsn: str, order_id: str):
    return _consulted(start_time, clickhouse_dsn, 'dx_src__stack_trace', order_id)


def orders(start_time: str, clickhouse_dsn: str):
    df = px.DataFrame('dx_anomaly_orders', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    return df[['uniqueID', 'rule', 'pod', 'order_id', 'lo', 'hi']]
