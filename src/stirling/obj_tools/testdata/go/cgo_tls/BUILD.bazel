load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//bazel:pl_build_system.bzl", "pl_go_binary", "pl_go_pie_binary")

package(default_visibility = ["//src/stirling:__subpackages__"])

go_library(
    name = "cgo_tls_lib",
    srcs = [
        "cgo_tls.go",
        "cgo_tls_stub.go",
    ],
    cgo = True,
    importpath = "px.dev/pixie/src/stirling/obj_tools/testdata/go/cgo_tls",
)

pl_go_binary(
    name = "cgo_tls",
    embed = [":cgo_tls_lib"],
    gc_linkopts = ["-linkmode=external"],
)

genrule(
    name = "cgo_tls_binary_target",
    srcs = [":cgo_tls"],
    outs = ["cgo_tls_binary"],
    cmd = "cp $(location :cgo_tls) $(location cgo_tls_binary)",
)

genrule(
    name = "cgo_tls_stripped_binary_target",
    srcs = [":cgo_tls"],
    outs = ["cgo_tls_stripped_binary"],
    cmd = "$(OBJCOPY) --strip-all $(location :cgo_tls) $(location cgo_tls_stripped_binary)",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)

pl_go_pie_binary(
    name = "cgo_tls_pie",
    embed = [":cgo_tls_lib"],
    gc_linkopts = ["-linkmode=external"],
)

genrule(
    name = "cgo_tls_pie_binary_target",
    srcs = [":cgo_tls_pie"],
    outs = ["cgo_tls_pie_binary"],
    cmd = "cp $(location :cgo_tls_pie) $(location cgo_tls_pie_binary)",
)

genrule(
    name = "cgo_tls_pie_stripped_binary_target",
    srcs = [":cgo_tls_pie"],
    outs = ["cgo_tls_pie_stripped_binary"],
    cmd = "$(OBJCOPY) --strip-all $(location :cgo_tls_pie) $(location cgo_tls_pie_stripped_binary)",
    toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
)
