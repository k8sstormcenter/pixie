      "instances": [
        {
          "index_key": "_/Namespace/_/elastic-system",
          "schema_version": 0,
          "attributes": {
            "id": "b3f8b839-a86a-4e88-9f29-d71ff33ec7c4",
            "manifest": "{\"apiVersion\":\"v1\",\"kind\":\"Namespace\",\"metadata\":{\"labels\":{\"app\":\"pl-cloud\",\"name\":\"elastic-system\"},\"name\":\"elastic-system\"}}",
