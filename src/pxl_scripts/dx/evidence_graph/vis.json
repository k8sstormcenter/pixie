  "widgets": [
    {
      "name": "CASES (culprit ns/pod/RootPID -> each step; one actor's campaign: read + exfil + spawns grouped)",
      "position": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "globalFuncOutputName": "g_cases",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Graph",
        "adjacencyList": {
          "fromColumn": "from_entity",
          "toColumn": "to_entity"
        },
        "edgeWeightColumn": "severity",
        "edgeColorColumn": "severity",
        "edgeLabelColumn": "mitre_technique",
        "edgeThresholds": {
          "mediumThreshold": 5,
          "highThreshold": 8
        },
        "edgeHoverInfo": [
          "order_link",
          "culprit_key",
          "rule_id",
          "mitre_tactic",
          "mitre_technique",
          "alert",
          "severity",
          "order_id"
        ],
        "edgeLength": 500
      }
    },
