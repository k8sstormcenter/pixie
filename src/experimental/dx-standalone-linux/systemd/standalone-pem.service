[Unit]
Description=Pixie standalone PEM (eBPF capture + ExecuteScript gRPC, no vizier/cloud)
Documentation=file:///.../src/experimental/standalone_pem
After=network-online.target
Wants=network-online.target

[Service]
# The PEM does eBPF (Stirling): needs privilege, host PID, and host /sys + rootfs.
# Ship the prebuilt binary (or run the container image via podman) as PX_PEM_BIN.
Environment=PX_STANDALONE_PEM_PORT=12345
Environment=PL_TABLE_STORE_DATA_LIMIT_MB=1024
Environment=PL_HOST_PATH=/
ExecStart=/usr/local/bin/standalone_pem
AmbientCapabilities=CAP_SYS_ADMIN CAP_BPF CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_NET_ADMIN CAP_PERFMON
# host PID visibility for process attribution; do NOT sandbox the mounts the PEM reads.
PrivateMounts=no
# resource containment (the k8s DaemonSet's cgroup limits, as systemd):
MemoryMax=2G
CPUQuota=200%
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
