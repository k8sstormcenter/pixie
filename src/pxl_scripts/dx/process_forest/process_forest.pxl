import px


def _scoped(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = px.DataFrame('dx_forest__process', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[px.contains(df.namespace, namespace)]
    df = df[px.contains(df.pod, pod)]
    df = df[px.contains(df.comm, comm)]
    df.in_pod = df.pod != ''
    df.keep = px.select(scope == 'all', True, df.in_pod)
    df = df[df.keep]
    df.exited = px.select(df.exit_ns > 0, px.int64_to_time(df.exit_ns), px.int64_to_time(df.exit_ns * 0))
    df.attr_code = px.select(df.attribution == 'pixie', 1,
                             px.select(df.attribution == 'cgroup', 2,
                                       px.select(df.attribution == 'lineage', 3, 4)))
    df.node = df.comm + ':' + px.itoa(df.pid) + '@' + df.hostname
    df.parent = df.pcomm + ':' + px.itoa(df.ppid) + '@' + df.hostname
    return df


def summary(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df.is_exec = px.select(df.origin == 'exec', 1, 0)
    df.is_exited = px.select(df.exit_ns > 0, 1, 0)
    df.is_pixie = px.select(df.attribution == 'pixie', 1, 0)
    df.is_cgroup = px.select(df.attribution == 'cgroup', 1, 0)
    df.is_lineage = px.select(df.attribution == 'lineage', 1, 0)
    df.is_runtime = px.select(df.runtime > 0, 1, 0)
    df = df.groupby(['namespace', 'pod', 'container', 'hostname']).agg(
        processes=('pid', px.count),
        execs=('is_exec', px.sum),
        exited=('is_exited', px.sum),
        pixie=('is_pixie', px.sum),
        cgroup=('is_cgroup', px.sum),
        lineage=('is_lineage', px.sum),
        runtime=('is_runtime', px.sum),
        comms=('comm', px.count),
        max_tree_depth=('tree_depth', px.max),
        first_started=('started_at', px.min),
        last_update=('event_time', px.max),
    )
    return df[['namespace', 'pod', 'container', 'hostname', 'processes', 'execs', 'exited', 'max_tree_depth',
               'pixie', 'cgroup', 'lineage', 'runtime', 'first_started', 'last_update']]


def forest(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df.weight = 1
    df = df.head(2000)
    return df[['path', 'tree_depth', 'parent', 'node', 'weight', 'attr_code', 'attribution', 'started_at',
               'exited', 'hostname', 'namespace', 'pod', 'container', 'pid', 'ppid', 'comm', 'pcomm', 'file',
               'execs', 'origin', 'anchor_pid', 'depth', 'boundary', 'gap', 'runtime', 'exit_code', 'signal',
               'upid', 'pupid', 'root_upid']]


def processes(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    return df[['path', 'tree_depth', 'started_at', 'exited', 'hostname', 'namespace', 'pod', 'container', 'pid',
               'ppid', 'comm', 'pcomm', 'file', 'execs', 'origin', 'attribution', 'depth', 'boundary', 'runtime',
               'exit_code', 'signal', 'upid', 'pupid', 'root_upid']]


def _events(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    p = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    p = p[['hostname', 'pid', 'pid_start']]
    e = px.DataFrame('dx_forest__events', clickhouse_dsn=clickhouse_dsn, start_time=start_time,
                     select=['time_', 'hostname', 'pid', 'pid_start', 'ev'])
    df = e.merge(p, how='inner', left_on=['hostname', 'pid', 'pid_start'],
                 right_on=['hostname', 'pid', 'pid_start'], suffixes=['', '_p'])
    df.kind = px.select(df.ev == 'F', 'fork', px.select(df.ev == 'E', 'exec', 'exit'))
    return df


def timeline(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _events(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df.time_ = px.bin(df.time_, px.minutes(1))
    df = df.groupby(['time_', 'kind']).agg(n=('pid', px.count))
    return df


def execs(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df = df[df.origin == 'exec']
    return df[['path', 'started_at', 'exited', 'hostname', 'namespace', 'pod', 'container', 'comm', 'pcomm', 'file',
               'execs', 'pid', 'ppid', 'tree_depth', 'attribution', 'exit_code']]


def exits(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df = df[df.exit_ns > 0]
    df.abnormal = (df.exit_code != 0) or (df.signal != 0)
    df = df[df.abnormal]
    return df[['exited', 'started_at', 'hostname', 'namespace', 'pod', 'container', 'comm', 'pcomm', 'file',
               'pid', 'ppid', 'exit_code', 'signal']]


def lineage(start_time: str, clickhouse_dsn: str, namespace: str, pod: str, comm: str, scope: str):
    df = _scoped(start_time, clickhouse_dsn, namespace, pod, comm, scope)
    df = df[df.attribution != 'pixie']
    df = df[df.pod != '']
    return df[['started_at', 'hostname', 'namespace', 'pod', 'container', 'pid', 'comm', 'pcomm',
               'attribution', 'anchor_pid', 'depth', 'boundary', 'gap', 'file', 'upid']]
