# Counts Kubescape anomaly alerts that Vector has written into
# forensic_db.alerts in the forensic ClickHouse cluster, windowed on
# event_time. One metric row per rule_id per invocation so the recorder can
# tag it as a per-rule series.

import px

df = px.DataFrame(
    '{{.TemplateValues.table}}',
    clickhouse_dsn='{{.TemplateValues.dsn}}',
    start_time='-{{.TemplateValues.window}}',
)

# forensic_db.kubescape_logs has (per the demo's observe.pxl probe)
# top-level columns: message, RuntimeK8sDetails, event_time. There is no
# top-level RuleID column — the rule id lives inside the JSON `message`
# payload. We just count total alerts in the window; per-rule breakdowns
# are left to downstream analysis.
df = df.agg(alert_count=('event_time', px.count))
df.timestamp = px.now()
df.node_name = px._exec_hostname()
df.pod = 'forensic-alert-driver'
df = df[['timestamp', 'node_name', 'pod', 'alert_count']]
px.display(df, 'forensic_alert_stats')
