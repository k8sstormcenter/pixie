import px


def _lc(start_time: str, clickhouse_dsn: str):
    return px.DataFrame('kubescape_rogue_lifecycle', clickhouse_dsn=clickhouse_dsn, start_time=start_time)


def lifecycle(start_time: str, clickhouse_dsn: str):
    df = _lc(start_time, clickhouse_dsn)
    df.profile = px.script_reference(df.workload_name, 'dx/shadow_profiles',
        {'start_time': start_time, 'clickhouse_dsn': clickhouse_dsn})
    return df[['namespace', 'workload_kind', 'workload_name', 'pod_name', 'container_name',
               'phase', 'started_firing', 'stopped_firing', 'snapshots', 'profile']]


def transitions(start_time: str, clickhouse_dsn: str):
    df = _lc(start_time, clickhouse_dsn)
    return df[['namespace', 'container_name', 'workload_kind', 'pod_name',
               'phase', 'started_firing', 'stopped_firing']]


def rogue(start_time: str, clickhouse_dsn: str):
    df = _lc(start_time, clickhouse_dsn)
    df = df[df.phase == 'Firing']
    agg = df.groupby(['namespace', 'workload_kind', 'container_name']).agg(
        firing=('name', px.count))
    return agg[['namespace', 'workload_kind', 'container_name', 'firing']]


def by_ns(start_time: str, clickhouse_dsn: str):
    df = _lc(start_time, clickhouse_dsn)
    df.from_entity = df.namespace
    df.to_entity = df.container_name
    agg = df.groupby(['from_entity', 'to_entity', 'phase']).agg(seen=('name', px.count))
    return agg[['from_entity', 'to_entity', 'phase', 'seen']]
