# dc_snoop tracepoint DEPLOYMENT (mutation) - run once at AE boot via the
# pixieapi mutation path (pxapi sets Mutation:true for `import pxtrace`).
# The retention/cron export path CANNOT deploy tracepoints (the mutation is
# dropped), so the AE owns this deploy separately. UpsertTracepoint is
# idempotent, so re-running at every boot is safe (create-if-absent / no-op).
# TTL 876000h (~100y) = effectively permanent; no reliance on the 24h re-run.

import pxtrace

# HEADER MODE ONLY — never introduce a BTF-only type here, and never let a
# BTF-mode bpftrace program run in this PEM. The first BTF-mode compile writes
# __btf_generated_header.h inside the PEM process; every later header-mode
# compile in that process then fails on kernel_cap_struct/__be64 redefinitions.
# The contamination is process-global and not necessarily ours: a third party
# deploying a BTF-mode tracepoint breaks these presets at their next compile,
# and the symptom surfaces in an unrelated component.
#
# A skipped probe does NOT fail the deploy: bpftrace warns "could not attach
# probe ... skipping" on the PEM's stderr and continues, so the tracepoint
# reports RUNNING with half the program dead. lookup_fast also cannot be
# re-attached inside a running PEM, so this cannot be repaired by re-upserting
# — confirm capture per probe type (t=R and t=M), and recover with a fresh PEM.
program = """
#include <linux/fs.h>
#include <linux/sched.h>
#include <linux/nsproxy.h>
#include <linux/pid_namespace.h>

// from fs/namei.c:
struct nameidata {
                struct path     path;
                struct qstr     last;
                // [...]
};

// 4026531836 = PROC_PID_INIT_INO, the init pid namespace (constant across
// kernels). Guarding in kprobe context drops host processes before the printf
// and before the map write, so they never reach the perf ring at all. Without
// it the ring overflows and takes the rows we WANT down with the noise.
kprobe:lookup_fast,
kprobe:lookup_fast.constprop.*
{
        $t = (struct task_struct *)curtask;
        if ($t->nsproxy->pid_ns_for_children->ns.inum != 4026531836) {
                $nd = (struct nameidata *)arg0;
                printf("time_:%llu pid:%d comm:%s t:%s file:%s",
                             nsecs, pid, comm, "R", str($nd->last.name));
        }
}

kprobe:d_lookup
{
        $t = (struct task_struct *)curtask;
        if ($t->nsproxy->pid_ns_for_children->ns.inum != 4026531836) {
                $name = (struct qstr *)arg1;
                @fname[tid] = $name->name;
        }
}

// Deliberately unguarded: the map is only ever populated by the guarded kprobe
// above, so a host process can never reach this block.
kretprobe:d_lookup
/@fname[tid]/
{
        printf("time_:%llu pid:%d comm:%s t:%s file:%s",
                     nsecs, pid, comm, "M", str(@fname[tid]));
        delete(@fname[tid]);
}
"""

pxtrace.UpsertTracepoint('dc_snoop', 'dc_snoop', program, pxtrace.kprobe(), "876000h")
