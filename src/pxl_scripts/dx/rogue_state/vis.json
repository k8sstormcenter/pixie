{
  "variables": [
    {
      "name": "start_time",
      "type": "PX_STRING",
      "description": "Window start.",
      "defaultValue": "-6h"
    },
    {
      "name": "clickhouse_dsn",
      "type": "PX_STRING",
      "description": "forensic_db DSN.",
      "defaultValue": "forensic_analyst:changeme-analyst@clickhouse-forensic-soc-db.clickhouse.svc.cluster.local:9000/forensic_db"
    }
  ],
  "globalFuncs": [
    {
      "outputName": "g_rogue",
      "func": {
        "name": "rogue",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          }
        ]
      }
    },
    {
      "outputName": "g_byns",
      "func": {
        "name": "by_ns",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "name": "Rogue containers \u2014 ungoverned by workload",
      "position": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "globalFuncOutputName": "g_rogue",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Table"
      }
    },
    {
      "name": "Rogue map \u2014 namespace to rogue container",
      "position": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "globalFuncOutputName": "g_byns",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Graph",
        "adjacencyList": {
          "fromColumn": "from_entity",
          "toColumn": "to_entity"
        },
        "edgeWeightColumn": "seen",
        "edgeColorColumn": "seen",
        "edgeLength": 400
      }
    }
  ]
}
