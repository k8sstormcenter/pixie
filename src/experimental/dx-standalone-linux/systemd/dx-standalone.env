# dx-daemon config for the single-VM PEM-direct deployment. Edit + copy to /etc/dx/.
DX_PORT=9099
DX_METRICS_PORT=9095
DX_BENCH=pxdirect
PX_DIRECT_ADDR=127.0.0.1:12345
DX_CATALOG_DIR=/etc/dx/catalog        # mount the 12-condition extended catalog here
DX_WORKERS=4
DX_PX_TIMEOUT_S=90
# DX_SBOB=/etc/dx/sbob.json           # operator-authored behaviour baseline (optional)
