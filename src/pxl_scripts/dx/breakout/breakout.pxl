# Breakout view — standalone forensic view of what a workload did once it
# deviated from its profile. Independent of dx/evidence_graph. The kubescape
# `alert` string from ClickHouse is the human-readable evidence (it names the
# exact command, file, and PID); used verbatim, no re-mapping. Plus an
# exfiltration-proof panel: the stolen bytes captured on the wire. Works only
# with ClickHouse enabled.

import px


def _dev(start_time: str, clickhouse_dsn: str, pod: str):
    df = px.DataFrame('dx_src__kubescape_mitre', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    return df[px.contains(df.pod, pod)]


def timeline(start_time: str, clickhouse_dsn: str, pod: str):
    # What the pod did, in order. `alert` is the full kubescape text (the command,
    # file, or capability + the offending child PID); `cmdline` the process line.
    df = _dev(start_time, clickhouse_dsn, pod)
    return df[['ts', 'alert', 'comm', 'pid', 'ppid', 'cmdline']]


def summary(start_time: str, clickhouse_dsn: str, pod: str):
    # Distinct alerts and how often each fired.
    df = _dev(start_time, clickhouse_dsn, pod)
    agg = df.groupby(['alert', 'mitre_technique']).agg(hits=('uniqueID', px.count))
    return agg[['alert', 'mitre_technique', 'hits']]


def killchain(start_time: str, clickhouse_dsn: str, pod: str):
    # Graph: the pod -> each distinct alert it raised. Node label = the alert
    # itself; edge weight = how many times.
    df = _dev(start_time, clickhouse_dsn, pod)
    agg = df.groupby(['pod', 'alert']).agg(hits=('uniqueID', px.count))
    agg.from_entity = px.Pod(agg.pod)
    agg.to_entity = agg.alert
    return agg[['from_entity', 'to_entity', 'alert', 'hits']]


def exfiltration(start_time: str, clickhouse_dsn: str):
    # PROOF OF EXFILTRATION: stolen data leaving over HTTP. The captured req_body
    # IS the payload — an eyJ...-prefixed body is a JWT (the ServiceAccount token).
    df = px.DataFrame('http_events', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[df.req_method == 'POST']
    df = df[px.contains(df.req_body, 'eyJ')]
    df.from_ip = df.remote_addr
    df.dest_pod = df.pod
    df.stolen_payload = df.req_body
    return df[['time_', 'from_ip', 'dest_pod', 'req_path', 'stolen_payload']]
