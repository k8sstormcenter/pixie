{
  "variables": [
    {
      "name": "start_time",
      "type": "PX_STRING",
      "description": "Window. The default is the one the release gate tests at.",
      "defaultValue": "-6h"
    },
    {
      "name": "clickhouse_dsn",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "forensic_analyst:changeme-analyst@clickhouse-forensic-soc-db.clickhouse.svc.cluster.local:9000/forensic_db"
    },
    {
      "name": "table",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "dx_src__kpi_proof"
    },
    {
      "name": "orders_table",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "dx_anomaly_orders"
    },
    {
      "name": "pod",
      "type": "PX_STRING",
      "description": "Substring of the alert's pod. Empty matches every covered pod.",
      "defaultValue": ""
    },
    {
      "name": "attack_pods",
      "type": "PX_STRING",
      "description": "Substring naming the pods that were actually attacked: the truth input for the confusion matrix. The default matches no pod, so the matrix reports nothing rather than a rate. Leaving it empty would match EVERY pod and turn the fleet sum into a fake detection rate; a rate of -1 means undefined, not zero.",
      "defaultValue": "__no_attack_set__"
    }
  ],
  "globalFuncs": [
    {
      "outputName": "g_alerts",
      "func": {
        "name": "alerts",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          },
          {
            "name": "table",
            "variable": "table"
          },
          {
            "name": "orders_table",
            "variable": "orders_table"
          },
          {
            "name": "pod",
            "variable": "pod"
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "name": "Detection matrix (needs attack_pods)",
      "func": {
        "name": "matrix",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          },
          {
            "name": "table",
            "variable": "table"
          },
          {
            "name": "attack_pods",
            "variable": "attack_pods"
          }
        ]
      },
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Table"
      },
      "position": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      }
    },
    {
      "name": "Matrix per suspicion",
      "func": {
        "name": "matrix_by_suspicion",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          },
          {
            "name": "table",
            "variable": "table"
          },
          {
            "name": "attack_pods",
            "variable": "attack_pods"
          }
        ]
      },
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Table"
      },
      "position": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 2
      }
    },
    {
      "name": "Per pod",
      "func": {
        "name": "by_pod",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
