[Unit]
Description=vizier-cloud-connector — the Pixie Cloud tunnel (deploy-key -> vzconn mTLS RegisterVizier)
After=pl-nats.service vizier-query-broker.service
Requires=vizier-query-broker.service
[Service]
EnvironmentFile=/etc/vizier/middleware.env
# PL_DEPLOY_KEY (from `px deploy-key create`) authenticates to PL_CLOUD_ADDR vzconn;
# RegisterVizier returns the cluster id + certs; the tunnel then carries the UI's
# PxL down to query-broker. Port :50800. Persist the assigned PL_CLUSTER_ID.
ExecStart=/usr/local/bin/vizier-cloud_connector_server
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
