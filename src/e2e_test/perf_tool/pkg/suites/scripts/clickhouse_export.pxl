# Exports a windowed slice of http_events to ClickHouse on every invocation,
# producing sustained load on the export path. px._pem_hostname() ensures the
# Map runs on the PEM so each row carries the correct hostname.

import px

df = px.DataFrame('http_events', start_time='-{{.TemplateValues.window}}')
df.hostname = px._pem_hostname()
px.export(df, px.otel.ClickHouseRows(
    table='{{.TemplateValues.table}}',
    endpoint=px.otel.Endpoint(
        url='{{.TemplateValues.dsn}}',
    ),
))

# Emit one metric row per invocation so we can chart export cadence and row
# counts. The metric recorder will pick up row_count as a single metric.
metric_df = df.groupby([]).agg(row_count=('time_', px.count))
metric_df.timestamp = px.now()
metric_df.node_name = px._exec_hostname()
metric_df.pod = 'clickhouse-export-driver'
metric_df = metric_df[['timestamp', 'node_name', 'pod', 'row_count']]
px.display(metric_df, 'export_stats')
