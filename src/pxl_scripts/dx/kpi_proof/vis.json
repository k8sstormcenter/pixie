{
  "variables": [
    {
      "name": "start_time",
      "type": "PX_STRING",
      "description": "Window. The default is the one the release gate tests at. For the confusion matrix it must contain exactly one demo run: sensitivity is unaffected by a wider window, but false positives are not, because an earlier run's attack pod is clean by this window's truth input. Narrow it to the run you are reading.",
      "defaultValue": "-6h"
    },
    {
      "name": "clickhouse_dsn",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "forensic_analyst:changeme-analyst@clickhouse-forensic-soc-db.clickhouse.svc.cluster.local:9000/forensic_db"
    },
    {
      "name": "table",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "dx_src__kpi_proof"
    },
    {
      "name": "orders_table",
      "type": "PX_STRING",
      "description": "",
      "defaultValue": "dx_anomaly_orders"
    },
    {
      "name": "pod",
      "type": "PX_STRING",
      "description": "Substring of the alert's pod. Empty matches every covered pod.",
      "defaultValue": ""
    },
    {
      "name": "attack_pods",
      "type": "PX_STRING",
      "description": "Substring naming the pods that were actually attacked: the truth input for the confusion matrix. THE WINDOW MUST HOLD ONE DEMO RUN. A substring names one attack set, so if start_time reaches back over an earlier run, that run's attack pod is not named here and its true positives are counted as false positives instead - measured once as precision 0.52 where the real value was 1.00. Widening the substring to a shared prefix is not the fix: it sweeps in pods that were never attacked and their correct non-detections become false negatives. The default matches no pod, so the matrix reports nothing rather than a rate; leaving it EMPTY would match every pod and turn the fleet sum into a fake detection rate. A rate of -1 means undefined, not zero.",
      "defaultValue": "__no_attack_set__"
    }
  ],
  "globalFuncs": [
    {
      "outputName": "g_alerts",
      "func": {
        "name": "alerts",
        "args": [
          {
            "name": "start_time",
            "variable": "start_time"
          },
          {
            "name": "clickhouse_dsn",
            "variable": "clickhouse_dsn"
          },
          {
            "name": "table",
            "variable": "table"
          },
          {
            "name": "orders_table",
            "variable": "orders_table"
          },
          {
            "name": "pod",
            "variable": "pod"
          },
          {
            "name": "attack_pods",
            "variable": "attack_pods"
          }
        ]
      }
    }
  ],
