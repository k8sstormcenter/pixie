import px

_SUMMARY = ''


def _proof(start_time: str, clickhouse_dsn: str, table: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[(df.kpi == 'K-P1.alert' or df.kpi == 'K-P1.unmatched')
            or df.kpi == 'K-P1.evidence']
    return df


def alerts(start_time: str, clickhouse_dsn: str, table: str, orders_table: str, pod: str,
           attack_pods: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]

    orders = px.DataFrame(orders_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    orders = orders.groupby('order_id').agg(
        rule=('rule', px.any),
        uniqueID=('uniqueID', px.any),
        order_pod=('pod', px.any),
        order_time=('event_time', px.max),
    )
    df = df.merge(orders, how='left', left_on=['order_id'], right_on=['order_id'],
                  suffixes=['', '_o'])

    df.evaluated_at = df.event_time
    df.kind = px.select(df.kpi == 'K-P1.evidence', 'evidence',
                        px.select(df.kpi == 'K-P1.unmatched', 'unmatched', 'alert'))
    df.rule_name = px.select(df.kpi == 'K-P1.evidence', 'scored on evidence',
                             px.select(df.rule == '', 'no order in window', df.rule))
    df.alert_time = df.order_time
    df.pod_match = px.select(df.kpi == 'K-P1.evidence', 'pod life',
                             px.select(df.rule == '', 'no order',
                                       px.select(df.order_pod == df.scope, 'ok', 'MISMATCH')))
    df.suspicion_name = px.select(df.suspicion == '', 'UNMATCHED', df.suspicion)
    df.pod_name = px.Pod(df.scope)

    df.called = _called(df)
    df.attacked = px.select(px.contains(df.scope, attack_pods), 1, 0)
    df.lens = 'all'
    truth = df.groupby('lens').agg(attacked_rows=('attacked', px.sum))
    df = df.merge(truth, how='left', left_on=['lens'], right_on=['lens'],
                  suffixes=['', '_t'])
    df.have_truth = px.select(df.attacked_rows > 0, 1, 0)

    df.proof = px.select(df.called == 1,
                         px.select(df.verdict == 'malicious', df.source, df.verdict), '')
    df.pod_role = px.select(df.attacked == 1, 'attack', 'clean')
    df.outcome = px.select(df.have_truth == 0, '',
                           px.select(df.kind == 'unmatched', '',
                                     px.select(df.called == 1,
                                               px.select(df.attacked == 1, 'detected',
                                                         'false-positive'),
                                               px.select(df.attacked == 1, 'missed',
                                                         'correct'))))
    df.verdict = px.select(df.called == 1, 'malicious', df.verdict)
    return df[['alert_time', 'pod_name', 'pod_role', 'suspicion_name', 'verdict', 'outcome',
               'proof', 'rule_name', 'kind', 'pc', 'num', 'den', 'hostname', 'pod_match',
               'class', 'order_pod', 'order_id', 'evaluated_at']]


def parts(start_time: str, clickhouse_dsn: str, table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part != _SUMMARY]
    df = df[px.contains(df.scope, pod)]
    df.pod_name = px.Pod(df.scope)
    df.suspicion_name = px.select(df.suspicion == '', 'UNMATCHED', df.suspicion)
    return df[['event_time', 'pod_name', 'suspicion_name', 'class', 'part', 'proven',
               'source', 'rows', 'order_id']]


def by_suspicion(start_time: str, clickhouse_dsn: str, table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]
    df = df[df.suspicion != '']

    df.is_detected = _called(df)
    df.is_gap = px.select(df.verdict == 'gap', 1, 0)
    df.is_benign = px.select(df.verdict == 'benign', 1, 0)
    df.is_unmatched = px.select(df.verdict == 'unmatched', 1, 0)
    df.is_probe_error = px.select(df.verdict == 'probe_error', 1, 0)
    return df.groupby('suspicion').agg(
        evaluations=('order_id', px.count),
        detected=('is_detected', px.sum),
        gaps=('is_gap', px.sum),
        benign=('is_benign', px.sum),
        unmatched=('is_unmatched', px.sum),
        probe_errors=('is_probe_error', px.sum),
        mean_parts_scored=('pc', px.mean),
        last_seen=('event_time', px.max),
    )


def _called(df):
    return px.select((df.verdict == 'forest' or df.verdict == 'wire')
                     or (df.verdict == 'dc_snoop' or df.verdict == 'malicious'), 1, 0)


def _finder(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[df.suspicion != '']
    df = df[px.contains(df.scope, attack_pods)]
    df.kind = px.select(df.kpi == 'K-P1.evidence', 'evidence',
                        px.select(df.kpi == 'K-P1.unmatched', 'unmatched', 'alert'))
    df.called = _called(df)
    df.is_alert = px.select(df.kind == 'alert', 1, 0)
    df.is_ev = px.select(df.kind == 'evidence', 1, 0)
    df.proved_by_alert = df.called * df.is_alert
    df.proved_by_ev = df.called * df.is_ev
    out = df.groupby('suspicion').agg(
        evaluations=('order_id', px.count),
        alerted=('is_alert', px.sum),
        proved=('called', px.sum),
        proved_alert=('proved_by_alert', px.sum),
        proved_evidence=('proved_by_ev', px.sum),
    )
    out.finder = px.select(out.alerted > 0 and out.proved == 0, 'kubescape only',
                           px.select(out.proved > 0 and out.proved_evidence == out.proved,
                                     'dx only',
                                     px.select(out.alerted > 0 and out.proved_alert > 0,
                                               'both', 'none')))
    return out


def who_found(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    out = _finder(start_time, clickhouse_dsn, table, attack_pods)
    return out[['suspicion', 'finder', 'alerted', 'proved', 'proved_alert',
                'proved_evidence', 'evaluations']]


def who_found_summary(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    out = _finder(start_time, clickhouse_dsn, table, attack_pods)
    out.is_ks = px.select(out.finder == 'kubescape only', 1, 0)
    out.is_dx = px.select(out.finder == 'dx only', 1, 0)
    out.is_both = px.select(out.finder == 'both', 1, 0)
    out.is_none = px.select(out.finder == 'none', 1, 0)
    out.lens = 'suspicions in window'
    return out.groupby('lens').agg(
        kubescape_only=('is_ks', px.sum),
        dx_only=('is_dx', px.sum),
        both=('is_both', px.sum),
        neither=('is_none', px.sum),
        suspicions=('finder', px.count),
    )


def by_pod(start_time: str, clickhouse_dsn: str, table: str, orders_table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]
    df = df[df.suspicion != '']
    df.infra = px.select(px.contains(df.scope, 'listener')
                         or px.contains(df.scope, 'controller'), 1, 0)
    df = df[df.infra == 0]
    df.called = _called(df)
    df.is_unproven = px.select(df.called == 1, 0, 1)
    df.pod_name = px.Pod(df.scope)
    agg = df.groupby(['pod_name', 'hostname', 'scope']).agg(
        evaluations=('order_id', px.count),
        matched=('called', px.sum),
        not_matched=('is_unproven', px.sum),
        mean_parts_scored=('pc', px.mean),
        first_seen=('event_time', px.min),
        last_seen=('event_time', px.max),
    )
    agg.own_window = '-' + px.itoa(
        px.floor((px.now() - agg.first_seen) / 1000000000) + 300) + 's'
    agg.score = px.script_reference(agg.scope, 'dx/kpi_proof', {
        'start_time': agg.own_window,
        'attack_pods': agg.scope,
        'pod': agg.scope,
    })
    agg.cases = px.script_reference('cases', 'dx/kpi_case', {
        'start_time': agg.own_window,
        'pod': agg.scope,
    })
    return agg[['pod_name', 'cases', 'score', 'hostname', 'evaluations', 'matched', 'not_matched',
                'mean_parts_scored', 'first_seen', 'last_seen', 'own_window']]


def _cells(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[df.suspicion != '']
    df.called = _called(df)
    df.attacked = px.select(px.contains(df.scope, attack_pods), 1, 0)
    df.tp_c = df.called * df.attacked
    df.fp_c = df.called * (1 - df.attacked)
    df.fn_c = (1 - df.called) * df.attacked
    df.tn_c = (1 - df.called) * (1 - df.attacked)
    return df


def matrix(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    df = _cells(start_time, clickhouse_dsn, table, attack_pods)
    df.lens = 'completed-detection'
    out = df.groupby('lens').agg(
        tp_r=('tp_c', px.sum), fp_r=('fp_c', px.sum),
        fn_r=('fn_c', px.sum), tn_r=('tn_c', px.sum),
    )
    out.under_attack = out.tp_r + out.fn_r
    out.have = px.select(out.under_attack == 0, 0, 1)
    out.tp = out.tp_r * out.have
    out.fn = out.fn_r * out.have
    out.fp = out.fp_r * out.have
    out.tn = out.tn_r * out.have
    out.clean = out.fp + out.tn
    out.sensitivity = px.select(out.have == 0, -1.0,
                                out.tp / (out.tp + out.fn))
    out.specificity = px.select(out.clean == 0, -1.0,
                                out.tn / (out.tn + out.fp))
    out.precision = px.select(out.tp + out.fp == 0, -1.0,
                              out.tp / (out.tp + out.fp))
    out.fp_rate = px.select(out.clean == 0, -1.0,
                            out.fp / (out.fp + out.tn))
    return out[['lens', 'tp', 'fn', 'fp', 'tn', 'under_attack', 'clean',
                'sensitivity', 'specificity', 'precision', 'fp_rate']]


def matrix_by_suspicion(start_time: str, clickhouse_dsn: str, table: str, attack_pods: str):
    df = _cells(start_time, clickhouse_dsn, table, attack_pods)
    out = df.groupby('suspicion').agg(
        tp_r=('tp_c', px.sum), fn_r=('fn_c', px.sum),
        fp_r=('fp_c', px.sum), tn_r=('tn_c', px.sum),
        mean_parts_scored=('pc', px.mean),
        last_seen=('event_time', px.max),
    )
    out.under_attack = out.tp_r + out.fn_r
    out.have = px.select(out.under_attack == 0, 0, 1)
    out.tp = out.tp_r * out.have
    out.fn = out.fn_r * out.have
    out.fp = out.fp_r * out.have
    out.tn = out.tn_r * out.have
    out.sensitivity = px.select(out.have == 0, -1.0,
                                out.tp / (out.tp + out.fn))
    return out[['suspicion', 'tp', 'fn', 'fp', 'tn', 'under_attack',
                'sensitivity', 'mean_parts_scored', 'last_seen']]


def unmatched_by_rule(start_time: str, clickhouse_dsn: str, table: str, orders_table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.kpi == 'K-P1.unmatched']
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]

    orders = px.DataFrame(orders_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    orders = orders.groupby('order_id').agg(rule=('rule', px.any))
    df = df.merge(orders, how='left', left_on=['order_id'], right_on=['order_id'],
                  suffixes=['', '_o'])
    df.pod_name = px.Pod(df.scope)
    df.rule_name = px.select(df.rule == '', 'no order in window', df.rule)
    return df.groupby(['rule_name', 'pod_name']).agg(
        alerts=('order_id', px.count),
        last_seen=('event_time', px.max),
    )
