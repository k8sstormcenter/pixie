          "attributes": {
            "id": "78ab650c-19f1-4374-bec6-9bab8e39782b",
            "manifest": "{\"apiVersion\":\"v1\",\"data\":{\"nats.conf\":\"pid_file: \\\"/var/run/nats/nats.pid\\\"\\nhttp: 8222\\n\\ntls {\\n  ca_file: \\\"/etc/nats-server-tls-certs/ca.crt\\\",\\n  cert_file: \\\"/etc/nats-server-tls-certs/server.crt\\\",\\n  key_file: \\\"/etc/nats-server-tls-certs/server.key\\\",\\n  timeout: 3\\n}\\n\\nserver_name: $POD_NAME\\njetstream {\\n  store_dir: /data/jetstream\\n}\\n\\ncluster {\\n  name: pl-nats\\n  port: 6222\\n  routes [\\n    nats://pl-nats-0.pl-nats:6222\\n    nats://pl-nats-1.pl-nats:6222\\n    nats://pl-nats-2.pl-nats:6222\\n  ]\\n\\n  tls {\\n    ca_file: \\\"/etc/nats-server-tls-certs/ca.crt\\\",\\n    cert_file: \\\"/etc/nats-server-tls-certs/server.crt\\\",\\n    key_file: \\\"/etc/nats-server-tls-certs/server.key\\\",\\n    timeout: 3\\n  }\\n\\n  advertise: $CLUSTER_ADVERTISE\\n  connect_retries: 30\\n}\\n\"},\"kind\":\"ConfigMap\",\"metadata\":{\"labels\":{\"app\":\"pl-cloud\",\"component\":\"cloud-deps\"},\"name\":\"nats-config\",\"namespace\":\"plc\"}}",
