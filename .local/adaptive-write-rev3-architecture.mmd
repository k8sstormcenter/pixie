%% =========================================================
classDef new fill:#d4ffd4,stroke:#080,stroke-width:2px;
class AS,SS,TS,HC new
class AS_STATE,AS_DELTA new
class SS_SUB new
class TS_LOOP,TS_WRITER new
class HC_TICK new
