# dx-daemon config for the single-VM PEM-direct deployment. Edit + copy to /etc/dx/.
# NOTE: systemd EnvironmentFile does NOT strip inline comments — a trailing
# "VALUE   # note" is kept verbatim in the value. Keep every comment on its OWN line.
DX_PORT=9099
DX_METRICS_PORT=9095
DX_BENCH=pxdirect
PX_DIRECT_ADDR=127.0.0.1:12345
# mount the 12-condition extended catalog at /etc/dx/catalog to enable it:
DX_CATALOG_DIR=/etc/dx/catalog
DX_WORKERS=4
DX_PX_TIMEOUT_S=90
# operator-authored behaviour baseline (optional):
# DX_SBOB=/etc/dx/sbob.json
