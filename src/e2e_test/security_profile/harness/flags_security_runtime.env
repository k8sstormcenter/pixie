# Flag-only "security-runtime" profile — every knob below is envvar-
# settable on a stock PEM image without rebuilding. The hypothesis
# behind each value is in the rightmost column; the harness reports
# coverage % vs the default profile so we know which knob earned its
# overhead.

# --- table-store budget (frees room for the non-http tables incl dns) -
PL_TABLE_STORE_DATA_LIMIT_MB=2048              # 1280 -> 2048: +60% total
PL_TABLE_STORE_HTTP_EVENTS_PERCENT=25          # 40 -> 25: takes 240 MB
                                               # off http, gives it to
                                               # the ~25 other tables;
                                               # dns share goes from
                                               # ~30 MB to ~74 MB.

# --- per-cpu socket-tracer bandwidth caps ----------------------------
# Control events are emitted per "new conn". UDP recon = lots of short
# 5-tuples = lots of control events. Default 5 MiB/s saturates under
# nmap-scale sweeps before the data plane even gets to the payload.
STIRLING_SOCKET_TRACER_TARGET_CONTROL_BW_PERCPU=20971520   # 5 MiB -> 20 MiB

# --- datastream buffer retention per direction ----------------------
# Default 1 MiB. Bumping helps keep partially-stuck parsers from
# dropping the buffer on the floor. DNS exchanges are tiny but bursts
# can be many of them.
PL_DATASTREAM_BUFFER_SIZE=4194304              # 1 MiB -> 4 MiB

# --- protocol set ----------------------------------------------------
PX_STIRLING_ENABLE_DNS_TRACING=1               # explicitly on (default)
# TLS deliberately OMITTED — see README.md / gh#2095.
