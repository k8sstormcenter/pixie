import px


def _cases(clickhouse_dsn: str, case_table: str, pod: str, kpi_version: str):
    df = px.DataFrame(case_table, clickhouse_dsn=clickhouse_dsn, start_time='-30d')
    df = df[px.contains(df.pod, pod)]
    df = df[px.contains(df.kpi_version, kpi_version)]
    return df


def _order_uid(start_time: str, clickhouse_dsn: str, orders_table: str):
    orders = px.DataFrame(orders_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    orders = orders.groupby(['order_id', 'uniqueID']).agg(seen=('event_time', px.min))
    return orders[['order_id', 'uniqueID']]


def _alert(start_time: str, clickhouse_dsn: str, logs_table: str, keys):
    raw = px.DataFrame(logs_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    raw = raw[raw.event_time >= px.now() + px.parse_duration(start_time)]
    raw.uid = px.pluck(raw.BaseRuntimeMetadata, 'uniqueID')
    raw.ns = px.pluck(raw.RuntimeK8sDetails, 'podNamespace')
    raw.pn = px.pluck(raw.RuntimeK8sDetails, 'podName')
    raw.pod = raw.ns + '/' + raw.pn
    raw = raw[['event_time', 'uid', 'pod', 'RuleID', 'message', 'hostname', 'BaseRuntimeMetadata',
               'RuntimeProcessDetails', 'RuntimeK8sDetails', 'event']]
    raw = raw.merge(keys, how='inner', left_on=['uid', 'pod'], right_on=['uid', 'pod'],
                    suffixes=['', '_k'])
    raw.alert_full = raw.RuleID + ' ' + raw.message + '\n' + 'node=' + raw.hostname
    raw.alert_full = raw.alert_full + '\n' + raw.BaseRuntimeMetadata
    raw.alert_full = raw.alert_full + '\n' + raw.RuntimeProcessDetails
    raw.alert_full = raw.alert_full + '\n' + raw.RuntimeK8sDetails
    raw.alert_full = px.select(raw.event == '', raw.alert_full, raw.alert_full + '\n' + raw.event)
    raw.emitted = raw.event_time
    out = raw.groupby(['uid', 'pod', 'emitted']).agg(alert_full=('alert_full', px.any))
    return out[['uid', 'pod', 'emitted', 'alert_full']]


def alerts(start_time: str, end_time: str, clickhouse_dsn: str, logs_table: str, case_table: str,
           orders_table: str, pod: str):
    raw = px.DataFrame(logs_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    raw = raw[raw.event_time >= px.now() + px.parse_duration(start_time)]
    raw = raw[raw.event_time <= px.now() + px.parse_duration(end_time)]
    raw.uid = px.pluck(raw.BaseRuntimeMetadata, 'uniqueID')
    raw.ns = px.pluck(raw.RuntimeK8sDetails, 'podNamespace')
    raw.pn = px.pluck(raw.RuntimeK8sDetails, 'podName')
    raw.pod = raw.ns + '/' + raw.pn
    raw = raw[px.contains(raw.pod, pod)]
    raw.alert_full = raw.RuleID + ' ' + raw.message + '\n' + 'node=' + raw.hostname
    raw.alert_full = raw.alert_full + '\n' + raw.BaseRuntimeMetadata
    raw.alert_full = raw.alert_full + '\n' + raw.RuntimeProcessDetails
    raw.alert_full = raw.alert_full + '\n' + raw.RuntimeK8sDetails
    raw.alert_full = px.select(raw.event == '', raw.alert_full, raw.alert_full + '\n' + raw.event)
    raw.n = 1
    a = raw.groupby(['uid', 'pod', 'RuleID']).agg(
        first=('event_time', px.min), last=('event_time', px.max), emissions=('n', px.sum))
    f = raw[['uid', 'pod', 'event_time', 'alert_full']]
    a = a.merge(f, how='inner', left_on=['uid', 'pod', 'first'], right_on=['uid', 'pod', 'event_time'],
                suffixes=['', '_f'])
    a = a.groupby(['uid', 'pod', 'RuleID', 'first', 'last', 'emissions']).agg(
        alert=('alert_full', px.any))
    c = _cases(clickhouse_dsn, case_table, pod, '')
    c = c[c.alert_ts > 0]
    ou = _order_uid(start_time, clickhouse_dsn, orders_table)
    c = c.merge(ou, how='left', left_on=['order_id'], right_on=['order_id'], suffixes=['', '_o'])
    c.uid = px.select(c.alert_uid != '', c.alert_uid, c.uniqueID)
    c.is_malicious = px.select(c.verdict == 'malicious', 1, 0)
    cc = c.groupby(['uid', 'pod']).agg(cases=('suspicion', px.count), malicious=('is_malicious', px.sum))
    a = a.merge(cc, how='left', left_on=['uid', 'pod'], right_on=['uid', 'pod'], suffixes=['', '_c'])
    a.run = px.script_reference(px.Pod(a.pod), 'dx/kpi_case', {
        'start_time': start_time, 'end_time': end_time, 'case_table': case_table, 'pod': a.pod})
    a.rule = a.RuleID
    a.first_seen = px.int64_to_time(a.first)
    a.last_seen = px.int64_to_time(a.last)
    return a[['first_seen', 'last_seen', 'emissions', 'run', 'rule', 'alert', 'cases', 'malicious']]


def cases(start_time: str, end_time: str, clickhouse_dsn: str, case_table: str, orders_table: str,
          logs_table: str, pod: str, kpi_version: str):
    df = _cases(clickhouse_dsn, case_table, pod, kpi_version)
    df.at = px.select(df.alert_ts > 0, df.alert_ts, df.scored_at)
    lo = px.now() + px.parse_duration(start_time)
    hi = px.now() + px.parse_duration(end_time)
    df = df[df.at >= lo]
    df = df[df.at <= hi]
    ou = _order_uid(start_time, clickhouse_dsn, orders_table)
    df = df.merge(ou, how='left', left_on=['order_id'], right_on=['order_id'], suffixes=['', '_o'])
    df.uid = px.select(df.alert_uid != '', df.alert_uid, df.uniqueID)
    keys = df.groupby(['uid', 'pod']).agg(n=('suspicion', px.count))
    keys = keys[['uid', 'pod']]
    al = _alert(start_time, clickhouse_dsn, logs_table, keys)
    j = df.merge(al, how='inner', left_on=['uid', 'pod'], right_on=['uid', 'pod'],
                 suffixes=['', '_a'])
    j.gap = px.abs(j.emitted - j.alert_ts)
    best = j.groupby(['pod', 'suspicion', 'kpi_version', 'scored_at']).agg(gap=('gap', px.min))
    j = j.merge(best, how='inner', left_on=['pod', 'suspicion', 'kpi_version', 'scored_at', 'gap'],
                right_on=['pod', 'suspicion', 'kpi_version', 'scored_at', 'gap'], suffixes=['', '_b'])
    j = j.groupby(['pod', 'suspicion', 'kpi_version', 'scored_at']).agg(
        alert_full=('alert_full', px.any), emitted=('emitted', px.min))
    df = df.merge(j, how='left', left_on=['pod', 'suspicion', 'kpi_version', 'scored_at'],
                  right_on=['pod', 'suspicion', 'kpi_version', 'scored_at'], suffixes=['', '_j'])
    df.at = px.select(df.alert_uid == '', px.select(df.emitted > 0, df.emitted, df.at), df.at)
    df.alert = px.select(df.uid == '', 'none — scored over the life of the pod',
                         px.select(df.alert_full == '',
                                   df.alert_rule + ' ' + df.alert_text, df.alert_full))
    df.pod_name = px.script_reference(px.Pod(df.pod), 'dx/kpi_proof', {
        'start_time': start_time, 'attack_pods': df.pod, 'pod': df.pod})
    df.order = px.script_reference(df.order_id, 'dx/evidence_graph', {
        'start_time': start_time, 'order_id': df.order_id})
    df.forest = px.script_reference('forest', 'dx/process_forest', {
        'start_time': start_time, 'namespace': '', 'pod': df.pod, 'comm': '', 'scope': 'pods'})
    df.dns = px.script_reference('dns', 'px/dns_data', {
        'start_time': start_time, 'source_filter': df.pod, 'destination_filter': ''})
    df.http = px.script_reference('http', 'px/http_data', {
        'start_time': start_time, 'source_filter': df.pod, 'destination_filter': ''})
    df.net = px.script_reference('net', 'px/pod', {'start_time': start_time, 'pod': df.pod})
    df.evidence = px.replace('dc_snoop', df.evidence, 'dentry_cache')
    df.proof = px.replace('dc_snoop', df.proof_source, 'dentry_cache')
    df.verdict = px.select(df.proof == '', df.verdict, df.verdict + ' · ' + df.proof)
    df.alert_at = px.int64_to_time(df.at)
    df.scored = px.int64_to_time(df.scored_at)
    return df[['alert_at', 'pod_name', 'suspicion', 'class', 'alert', 'evidence', 'verdict', 'order',
               'forest', 'dns', 'http', 'net', 'evidence_rows', 'scored', 'kpi_version']]


def suites(start_time: str, end_time: str, clickhouse_dsn: str, case_table: str):
    df = px.DataFrame(case_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time, end_time=end_time)
    df.is_malicious = px.select(df.verdict == 'malicious', 1, 0)
    df.is_gap = px.select(df.verdict == 'gap', 1, 0)
    df.is_benign = px.select(df.verdict == 'benign', 1, 0)
    return df.groupby(['kpi_version', 'suite', 'pod']).agg(
        cases=('suspicion', px.count),
        malicious=('is_malicious', px.sum),
        gap=('is_gap', px.sum),
        benign=('is_benign', px.sum),
        first_scored=('event_time', px.min),
        last_scored=('event_time', px.max),
    )
