# Presentation view — one host's presenting signs when it departs from its
# established baseline. Reads the full finding text (`symptom`) from ClickHouse;
# `sign` = the leading phrase, `site` = the first token after it. Graph edge =
# sign, node = site, hover = the full symptom. Works only with ClickHouse enabled.

import px


def learned(start_time: str, clickhouse_dsn: str):
    df = px.DataFrame('kubescape_profiles', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[df.kind == 'shadow']
    agg = df.groupby(['namespace', 'name']).agg(
        completion=('completion', px.any), status=('status', px.any),
        execs=('execs', px.max), opens=('opens', px.max),
        egress=('egress', px.max), syscalls=('syscalls', px.max))
    return agg[['namespace', 'name', 'completion', 'status', 'execs', 'opens', 'egress', 'syscalls']]
