{
  "variables": [
    {
      "name": "start_time",
      "type": "PX_STRING",
      "description": "Window start.",
      "defaultValue": "-6h"
    },
    {
      "name": "clickhouse_dsn",
      "type": "PX_STRING",
      "description": "forensic_db DSN.",
      "defaultValue": "forensic_analyst:changeme-analyst@clickhouse-forensic-soc-db.clickhouse.svc.cluster.local:9000/forensic_db"
    }
  ],
  "globalFuncs": [
    {
      "outputName": "g_tactics",
      "func": {
        "name": "tactics",
        "args": [
          {"name": "start_time", "variable": "start_time"},
          {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}
        ]
      }
    },
    {
      "outputName": "g_hosts",
      "func": {
        "name": "hosts",
        "args": [
          {"name": "start_time", "variable": "start_time"},
          {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}
        ]
      }
    },
    {
      "outputName": "g_findings",
      "func": {
        "name": "findings",
        "args": [
          {"name": "start_time", "variable": "start_time"},
          {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}
        ]
      }
    }
  ],
  "widgets": [
    {
      "name": "MITRE tactic → host (click a host cell in the tables to drill in)",
      "position": {"x": 0, "y": 0, "w": 12, "h": 4},
      "globalFuncOutputName": "g_tactics",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Graph",
        "adjacencyList": {"fromColumn": "from_entity", "toColumn": "to_entity"},
        "edgeWeightColumn": "hits",
        "edgeLength": 400
      }
    },
    {
      "name": "Hosts (host → breakout, profiles, rogue state)",
      "position": {"x": 0, "y": 4, "w": 12, "h": 4},
      "globalFuncOutputName": "g_hosts",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Table"
      }
    },
    {
      "name": "Findings (what ran, MITRE → evidence graph deeplink per finding)",
      "position": {"x": 0, "y": 8, "w": 12, "h": 6},
      "globalFuncOutputName": "g_findings",
      "displaySpec": {
        "@type": "types.px.dev/px.vispb.Table"
      }
    }
  ]
}
