#
# source_table: the Pixie events table to read from (e.g. http_events,
#   redis_events). dest_table: the ClickHouse destination table name. These
# must have compatible column shapes — exporting http_events rows to a
# pre-existing CH table created for redis_events will make the CH server
# reject the INSERT on the first column mismatch, and the clickhouse-cpp
# client will rethrow that as an uncaught std::exception, crashing Kelvin
# (see ClickHouseExportSinkNode TODO).

import px

df = px.DataFrame('{{.TemplateValues.source_table}}', start_time='-{{.TemplateValues.window}}')
df.hostname = px.upid_to_hostname(df.upid)
px.export(df, px.otel.ClickHouseRows(
    table='{{.TemplateValues.dest_table}}',
    endpoint=px.otel.Endpoint(
        url='{{.TemplateValues.dsn}}',
    ),
))

# Emit one metric row per invocation so we can chart export cadence and row
# counts. The metric recorder will pick up row_count as a single metric.
metric_df = df.groupby([]).agg(
    row_count=('time_', px.count),
    node_name=('hostname', px.any),
)
metric_df.timestamp = px.now()
metric_df.pod = 'clickhouse-export-driver'
metric_df = metric_df[['timestamp', 'node_name', 'pod', 'row_count']]
px.display(metric_df, 'export_stats')
