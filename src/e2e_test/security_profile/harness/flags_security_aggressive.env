# Flag-only "security-aggressive" — security-runtime plus the
# bandwidth caps raised so high we're effectively only constrained by
# PEM CPU and memory. Run this to find the practical ceiling of what
# flags alone can achieve before code changes are needed.

# Everything from security-runtime …
PL_TABLE_STORE_DATA_LIMIT_MB=3072              # 2048 -> 3072
PL_TABLE_STORE_HTTP_EVENTS_PERCENT=15          # 25 -> 15: more for dns
STIRLING_SOCKET_TRACER_TARGET_CONTROL_BW_PERCPU=104857600   # 100 MiB/s
PL_DATASTREAM_BUFFER_SIZE=8388608              # 8 MiB

# … plus raise the data bw cap too (default 100 MiB/s). UDP DNS is
# small but a 5000 q/s sweep can hit it briefly.
STIRLING_SOCKET_TRACER_TARGET_DATA_BW_PERCPU=419430400      # 100 MiB -> 400 MiB

# global ceiling — default already 10 Gbit/s; bump to 40 Gbit just so
# the per-CPU caps above don't get clipped by it.
STIRLING_SOCKET_TRACER_MAX_TOTAL_DATA_BW=5368709120         # 40 Gbit/s

PX_STIRLING_ENABLE_DNS_TRACING=1
# TLS deliberately omitted.
