flowchart TB

%% =========================================================
%% EXTERNAL ACTORS
%% =========================================================
subgraph EXT["External actors (per node)"]
  KS["Kubescape DaemonSet<br/>node-agent<br/>emits anomalies"]
  VEC["Vector DaemonSet<br/>forwards kubescape logs<br/>→ ClickHouse"]
  PEM["Pixie PEM DaemonSet<br/>eBPF socket tracer<br/>protocol classifier"]
end

subgraph PIXIE["Pixie (cluster + cloud)"]
  QB["vizier-query-broker<br/>gRPC :50300<br/>(direct mode bypass)"]
  KEL["kelvin / metadata"]
  RP["Cloud retention plugin<br/>(optional alt write path)"]
end

subgraph CH["ClickHouse forensic_db (single replica)"]
  T_KL[("kubescape_logs<br/><i>NOT operator-owned</i><br/>owner: soc installer + Vector")]
  T_AL[("alerts<br/><i>NOT operator-owned</i>")]
  T_AA[("adaptive_attribution<br/>ReplacingMergeTree(t_end)<br/>ORDER BY (hostname, anomaly_hash)<br/><b>operator's primary write target</b>")]
  T_WM[("trigger_watermark<br/>ReplacingMergeTree(updated_at)<br/>ORDER BY (hostname, table_name)<br/><b>persistent cursor — new</b>")]
  T_PX[("12 pixie observation tables<br/>http_events, redis_events,<br/>pgsql_events, dns_events,<br/>mysql_events, cql_events,<br/>mongodb_events, amqp_events,<br/>mux_events, tls_events,<br/>http2_messages.beta,<br/>kafka_events.beta")]
end

%% =========================================================
%% OPERATOR — adaptive_export pod (1 per node, DaemonSet)
%% =========================================================
subgraph OP["adaptive_export pod (1 per node)"]

  subgraph BOOT["Boot sequence (main.go)"]
    direction TB
    B1["1. clickhouse.Applier.Apply<br/>CREATE TABLE IF NOT EXISTS<br/>12 pixie tables + adaptive_attribution + trigger_watermark"]
    B2["2. applier.VerifyPixieSchema<br/>drift guard"]
    B3["3. pixie.Client.EnsureClickHousePluginEnabled<br/>(toggles cloud retention plugin)"]
    B3b["3b. installPresetScripts (optional)<br/>installs ch-* PxL scripts"]
    B4["4. build trigger + sink + controller<br/>(no goroutines started yet)"]
    B5["5. controller.Rehydrate<br/>SELECT FROM adaptive_attribution FINAL<br/>WHERE hostname=NODE AND t_end>now"]
    B6["6. start prune goroutine + controller goroutine"]
    B1 --> B2 --> B3 --> B3b --> B4 --> B5 --> B6
  end

  subgraph TRG["Trigger goroutine (1)"]
    direction TB
    TR_INIT["t.run() startup:<br/>load watermark from store<br/>(cold-start order: persistent > InitialWatermark > 0)"]
    TR_POLL["pollOnce() — every 250ms"]
    TR_FETCH["fetchSince(watermark)<br/>HTTP GET CH<br/>SELECT … WHERE hostname=NODE<br/>AND event_time >= watermark<br/>ORDER BY event_time LIMIT 10000<br/>(30s HTTP timeout)"]
    TR_PARSE["parseJSONEachRow<br/>partial-read tolerance<br/>(returns rows + err)"]
    TR_DEDUP["dedup at watermark boundary<br/>(in-mem fingerprint set)"]
    TR_EXTRACT["kubescape.Extract<br/>JSON → Event{Target, EventTime, RuleID}"]
    TR_OUT["out ← ev<br/>(buffered chan, size 64)"]
    TR_ADV["watermark = max(watermark, ev.EventTime)<br/>dirty = true"]
    TR_FLUSH["flushWatermark()<br/>throttled INSERT every ≥5s<br/>called every 256 rows AND end-of-pollOnce<br/>(NOT a separate ticker — would starve)"]
    TR_INIT --> TR_POLL
    TR_POLL --> TR_FETCH --> TR_PARSE --> TR_DEDUP --> TR_EXTRACT --> TR_OUT
    TR_EXTRACT --> TR_ADV
    TR_ADV -.every 256 rows + end.-> TR_FLUSH
    TR_POLL -.tick.-> TR_POLL
  end

  subgraph CTL["Controller event loop (1 goroutine)"]
    direction TB
    C_RUN["controller.Run<br/>for ev := range ch"]
    C_HANDLE["handle(ev)"]
    C_HASH["anomaly.Hash(Target)<br/>SHA256(PID:Comm:Pod:Namespace)[:16]"]
    C_LOCK["mu.Lock — check active[hash]"]
    C_NEW{"hash in active?"}
    C_CREATE["create AttributionRow<br/>t_start = event_time − Before<br/>t_end = now + After"]
    C_EXTEND["extend t_end = max(t_end, now+After)<br/>bump LastSeen, NAnomalies++"]
    C_SPAWN{"querier != nil<br/>AND !inFlight[hash]?"}
    C_MARK["inFlight[hash] = true"]
    C_UNLOCK["mu.Unlock"]
    C_SINK["sink.Write(attribution rows)<br/>HTTP POST CH (60s timeout)<br/>INSERT INTO adaptive_attribution"]
    C_GO["go pushPixieRows(snapshot)<br/>defer { delete inFlight[hash] }"]

    C_RUN --> C_HANDLE --> C_HASH --> C_LOCK --> C_NEW
    C_NEW -- no --> C_EXTEND --> C_SPAWN
    C_NEW -- yes --> C_CREATE --> C_SPAWN
    C_SPAWN -- yes --> C_MARK --> C_UNLOCK
    C_SPAWN -- no --> C_UNLOCK
    C_UNLOCK --> C_SINK
    C_UNLOCK --> C_GO
  end

  subgraph FAN["pushPixieRows fan-out (1 goroutine per active hash)"]
    direction TB
    F_LOOP["pass loop:<br/>re-snapshot active[hash]<br/>exit if !exists OR t_end past"]
    F_PSEM{{"perHashSem<br/>buffered chan, size N<br/>(MaxParallelQueriesPerHash)<br/>nil = unbounded ← BUG SOURCE"}}
    F_TABLES["for table in PushPixieTables (10):<br/>check shouldSkipEmpty(pod, table)"]
    F_QGEN["pxl.QueryFor(table, target,<br/>sliceStart, sliceEnd, now)<br/>builds PxL string"]
    F_TGO["spawn table goroutine"]
    F_GSEM{{"globalSem<br/>buffered chan, size M<br/>(MaxInflightQueriesGlobal)<br/>shared across ALL fan-outs"}}
    F_QUERY["querier.Query(qctx, pxl)<br/>(180s timeout)"]
    F_NOTE["noteQueryResult(pod, table, nrows)<br/>updates emptyStreak / emptySkipUntil"]
    F_WRITE["if nrows>0:<br/>sink.WritePixieRows<br/>HTTP POST CH (60s timeout)<br/>INSERT INTO <table>"]
    F_ADV["lastUpper[table] = sliceEnd<br/>(advance per-table cursor)"]
    F_WAIT["wg.Wait() all table goroutines<br/>sleep PushRefreshInterval (30s)<br/>then next pass"]

    F_LOOP --> F_TABLES --> F_QGEN --> F_TGO
    F_TGO --> F_PSEM --> F_GSEM --> F_QUERY --> F_NOTE --> F_WRITE --> F_ADV
    F_ADV --> F_WAIT --> F_LOOP
  end

  subgraph PRN["Prune goroutine (1)"]
    PR_TICK["ticker — every 30s<br/>PruneExpired()<br/>removes active[h]<br/>where t_end+2*After < now"]
  end

  subgraph STATE["In-memory state (per process)"]
    direction TB
    S_ACTIVE[("active map<br/>AnomalyHash → AttributionRow<br/>mu.Lock guarded")]
    S_INFLIGHT[("inFlight set<br/>AnomalyHash → bool<br/>mu.Lock guarded")]
    S_EMPTY[("emptyStreak + emptySkipUntil<br/>pod|table → count / time<br/>emptyCacheMu guarded")]
    S_GSEM[("globalSem chan<br/>(if configured)")]
    S_WATERMARK[("watermark uint64<br/>seenAtBoundary set<br/>trigger-local")]
  end
end

%% =========================================================
%% FLOWS
%% =========================================================
KS -- "kubescape Alert JSON" --> VEC
VEC -- "POST INSERT" --> T_KL
PEM -- "writes via cloud retention plugin (in-cluster or out)" --> T_PX
RP -- "writes (alt path, often unused)" --> T_PX

%% Boot
BOOT -.HTTP DDL.-> T_AA
BOOT -.HTTP DDL.-> T_WM
BOOT -.HTTP DDL.-> T_PX
BOOT -.gRPC.-> RP
B5 -- "SELECT FINAL" --> T_AA
B5 -- "rehydrate" --> S_ACTIVE

%% Trigger
TR_FETCH -- "HTTP GET" --> T_KL
TR_INIT -- "Load(hostname, kubescape_logs)" --> T_WM
TR_FLUSH -- "INSERT" --> T_WM
TR_ADV --> S_WATERMARK
TR_OUT -- "buffered chan (64)" --> C_RUN

%% Controller
C_LOCK <--> S_ACTIVE
C_LOCK <--> S_INFLIGHT
C_SINK -- "POST INSERT" --> T_AA
C_GO -- "spawn (one per hash)" --> FAN

%% Fan-out
F_LOOP <--> S_ACTIVE
F_TABLES <--> S_EMPTY
F_GSEM <--> S_GSEM
F_QUERY -- "gRPC ExecuteScript (direct)" --> QB
F_QUERY -. "OR via cloud passthrough" .-> KEL
F_WRITE -- "POST INSERT per-table" --> T_PX
F_NOTE --> S_EMPTY
FAN -.defer.-> S_INFLIGHT

%% Prune
PR_TICK <--> S_ACTIVE
