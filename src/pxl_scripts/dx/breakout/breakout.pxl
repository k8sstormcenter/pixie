#
# Breakout view — standalone. Shows the rogue-shadow-profile evidence for one
# workload: every action it took that its profile (signed base + learned shadow)
# did NOT allow. Each deviation's `alert` text carries the actual command the
# exploit spawned and the offending child PID — kubescape stamps the container's
# own pid on the structured row, so the child pid lives only in the alert string.
# Works only with ClickHouse enabled. Independent of dx/evidence_graph.

import px


def _dev(start_time: str, clickhouse_dsn: str, pod: str):
    df = px.DataFrame('dx_src__kubescape_mitre', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    return df[px.contains(df.pod, pod)]


def timeline(start_time: str, clickhouse_dsn: str, pod: str):
    # Chronological deviation stream — one row per flagged action. `alert` is the
    # evidence (e.g. "Unexpected process launched: cat ... to serviceaccount/token").
    df = _dev(start_time, clickhouse_dsn, pod)
    return df[['ts', 'RuleID', 'mitre_tactic', 'mitre_technique', 'alert', 'comm', 'pid', 'ppid']]


def killchain(start_time: str, clickhouse_dsn: str, pod: str):
    # Graph: subject pod -> each MITRE step it tripped; edge weight = hit count.
    df = _dev(start_time, clickhouse_dsn, pod)
    df.step = df.RuleID + ' ' + df.mitre_technique
    agg = df.groupby(['pod', 'step', 'RuleID', 'mitre_tactic', 'mitre_technique']).agg(
        hits=('uniqueID', px.count))
    agg.from_entity = px.Pod(agg.pod)
    agg.to_entity = agg.step
    return agg[['from_entity', 'to_entity', 'RuleID', 'mitre_tactic', 'mitre_technique', 'hits']]


def summary(start_time: str, clickhouse_dsn: str, pod: str):
    # Rule tally for the workload — the shape of the breakout at a glance.
    df = _dev(start_time, clickhouse_dsn, pod)
    agg = df.groupby(['RuleID', 'mitre_tactic', 'mitre_technique']).agg(hits=('uniqueID', px.count))
    return agg[['RuleID', 'mitre_tactic', 'mitre_technique', 'hits']]
