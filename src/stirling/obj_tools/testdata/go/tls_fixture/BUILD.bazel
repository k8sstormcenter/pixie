load("@io_bazel_rules_go//go:def.bzl", "go_cross_binary", "go_library")
load("//bazel:pl_build_system.bzl", "pl_go_binary", "pl_go_sdk_version_template_to_label", "pl_supported_go_sdk_versions")

package(default_visibility = ["//src/stirling:__subpackages__"])

go_library(
    name = "tls_fixture_lib",
    srcs = ["main.go"],
    importpath = "px.dev/pixie/src/stirling/obj_tools/testdata/go/tls_fixture",
    visibility = ["//visibility:private"],
)

pl_go_binary(
    name = "tls_fixture",
    embed = [":tls_fixture_lib"],
)

[
    go_cross_binary(
        name = pl_go_sdk_version_template_to_label("test_go_tls_%s_binary", sdk_version),
        sdk_version = sdk_version,
        tags = ["manual"],
        target = ":tls_fixture",
    )
    for sdk_version in pl_supported_go_sdk_versions
]

go_tls_fixture_versions = [v.replace(".", "_") for v in pl_supported_go_sdk_versions] + [
    "1_25",
    "1_26",
]

[
    genrule(
        name = "test_go_tls_%s_stripped_binary_target" % v,
        srcs = [":test_go_tls_%s_binary" % v],
        outs = ["test_go_tls_%s_stripped_binary" % v],
        cmd = "$(OBJCOPY) --strip-all $< $@",
        toolchains = ["@bazel_tools//tools/cpp:current_cc_toolchain"],
    )
    for v in go_tls_fixture_versions
]

filegroup(
    name = "test_binaries",
    testonly = True,
    srcs = [":test_go_tls_%s_binary" % v for v in go_tls_fixture_versions] +
           [":test_go_tls_%s_stripped_binary" % v for v in go_tls_fixture_versions],
)
