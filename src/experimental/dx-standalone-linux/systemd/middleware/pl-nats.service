[Unit]
Description=pl-nats — NATS message bus for the vizier middleware
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/local/bin/nats-server -p 4222 -m 8222
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
