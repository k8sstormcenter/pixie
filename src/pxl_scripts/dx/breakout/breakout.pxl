# Runtime-breakout story — workload-agnostic; ClickHouse only.
#
# A workload deviating from its (ideally SIGNED) ContainerProfile, seen as the
# pod fanning out to the off-profile targets node-agent flagged. Reads
# dx_breakout_story (a view over kubescape_logs, infra namespaces excluded): the
# kind column encodes the beat — process (reverse shell / dropped binary),
# proc-read/libload (/proc lib trick), token-read (SA cred), sensitive, egress,
# ingress, dns. IngressNightmare, React2Shell, a redis break — same graph, any
# namespace. Leave `namespace` empty for every flagged workload, or focus one.

import px


def _rows(start_time: str, clickhouse_dsn: str, namespace: str):
    e = px.DataFrame('dx_breakout_story', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    return e[px.contains(e.namespace, namespace)]


def story(start_time: str, clickhouse_dsn: str, namespace: str):
    e = _rows(start_time, clickhouse_dsn, namespace)
    g = e.groupby(['namespace', 'from_node', 'to_node', 'kind', 'rule']).agg(
        events=('sev', px.count), sev=('sev', px.max))
    g.from_entity = g.from_node
    g.to_entity = g.to_node
    return g[['from_entity', 'to_entity', 'kind', 'rule', 'events', 'sev', 'namespace']]


def beats(start_time: str, clickhouse_dsn: str, namespace: str):
    # The attack beats, per workload: what each pod touched off-profile.
    e = _rows(start_time, clickhouse_dsn, namespace)
    s = e.groupby(['namespace', 'kind', 'rule']).agg(events=('sev', px.count), sev=('sev', px.max))
    return s[['namespace', 'kind', 'rule', 'sev', 'events']]


def targets(start_time: str, clickhouse_dsn: str, namespace: str):
    e = _rows(start_time, clickhouse_dsn, namespace)
    s = e.groupby(['namespace', 'kind', 'to_node']).agg(events=('sev', px.count))
    return s[['namespace', 'kind', 'to_node', 'events']]
