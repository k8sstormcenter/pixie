import px

_SUMMARY = ''


def _proof(start_time: str, clickhouse_dsn: str, table: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[(df.kpi == 'K-P1.alert' or df.kpi == 'K-P1.unmatched')
            or df.kpi == 'K-P1.evidence']
    return df


def alerts(start_time: str, clickhouse_dsn: str, table: str, orders_table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]

    orders = px.DataFrame(orders_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    orders = orders.groupby('order_id').agg(
        rule=('rule', px.any),
        uniqueID=('uniqueID', px.any),
        order_pod=('pod', px.any),
        order_time=('event_time', px.max),
    )
    df = df.merge(orders, how='left', left_on=['order_id'], right_on=['order_id'],
                  suffixes=['', '_o'])

    df.evaluated_at = df.event_time
    df.kind = px.select(df.kpi == 'K-P1.evidence', 'evidence',
                        px.select(df.kpi == 'K-P1.unmatched', 'unmatched', 'alert'))
    df.rule_name = px.select(df.kpi == 'K-P1.evidence', 'scored on evidence',
                             px.select(df.rule == '', 'no order in window', df.rule))
    df.alert_time = df.order_time
    df.pod_match = px.select(df.kpi == 'K-P1.evidence', 'pod life',
                             px.select(df.rule == '', 'no order',
                                       px.select(df.order_pod == df.scope, 'ok', 'MISMATCH')))
    df.suspicion_name = px.select(df.suspicion == '', 'UNMATCHED', df.suspicion)
    df.pod_name = px.Pod(df.scope)
    return df[['alert_time', 'hostname', 'pod_name', 'kind', 'rule_name', 'pod_match',
               'suspicion_name', 'class', 'verdict', 'pc', 'num', 'den', 'order_pod',
               'order_id', 'evaluated_at']]


def parts(start_time: str, clickhouse_dsn: str, table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part != _SUMMARY]
    df = df[px.contains(df.scope, pod)]
    df.pod_name = px.Pod(df.scope)
    df.suspicion_name = px.select(df.suspicion == '', 'UNMATCHED', df.suspicion)
    return df[['event_time', 'pod_name', 'suspicion_name', 'class', 'part', 'proven',
               'source', 'rows', 'predicate', 'order_id']]


def by_suspicion(start_time: str, clickhouse_dsn: str, table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]
    df = df[df.suspicion != '']

    df.is_gap = px.select(df.verdict == 'gap', 1, 0)
    df.is_probe_error = px.select(df.verdict == 'probe_error', 1, 0)
    df.is_proven = px.select(df.pc >= 1.0, 1, 0)
    return df.groupby('suspicion').agg(
        evaluations=('order_id', px.count),
        mean_pc=('pc', px.mean),
        proven=('is_proven', px.sum),
        gaps=('is_gap', px.sum),
        probe_errors=('is_probe_error', px.sum),
        last_seen=('event_time', px.max),
    )


def unmatched_by_rule(start_time: str, clickhouse_dsn: str, table: str, orders_table: str, pod: str):
    df = _proof(start_time, clickhouse_dsn, table)
    df = df[df.kpi == 'K-P1.unmatched']
    df = df[df.part == _SUMMARY]
    df = df[px.contains(df.scope, pod)]

    orders = px.DataFrame(orders_table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    orders = orders.groupby('order_id').agg(rule=('rule', px.any))
    df = df.merge(orders, how='left', left_on=['order_id'], right_on=['order_id'],
                  suffixes=['', '_o'])
    df.pod_name = px.Pod(df.scope)
    df.rule_name = px.select(df.rule == '', 'no order in window', df.rule)
    return df.groupby(['rule_name', 'pod_name']).agg(
        alerts=('order_id', px.count),
        last_seen=('event_time', px.max),
    )
