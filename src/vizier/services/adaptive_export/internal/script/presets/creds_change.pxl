# creds_change EXPORT (retention cron) — query the creds_change tracepoint table
# and export to ClickHouse. The tracepoint is deployed by the AE at boot
# (creds_change_deploy.pxl); a cron script cannot deploy it. Read + export only.

import px

table_name = 'creds_change'
df = px.DataFrame(table=table_name, start_time=px.plugin.start_time, end_time=px.plugin.end_time)
# event_time as nanoseconds -> sink emits DateTime64(9) (see dc_snoop.pxl).
df.event_time = df.time_
px.export(df, px.otel.ClickHouseRows(table=table_name))
