import px


def evidence_graph(start_time: str, clickhouse_dsn: str, table: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df.from_entity = px.Pod(df.subject_pod)
    df.to_entity = df.target
    return df[['from_entity', 'to_entity',
               'uniqueID', 'rule', 'process', 'target', 'target_kind',
               'severity', 'alert', 'subject_pod']]


def consulted_findings(start_time: str, clickhouse_dsn: str, table: str, uniqueID: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[px.contains(df.uniqueID, uniqueID)]
    return df[['uniqueID', 'rule', 'comm', 'parent', 'cmdline', 'alert']]
