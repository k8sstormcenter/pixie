{
  "variables": [
    {"name": "start_time", "type": "PX_STRING", "description": "Incident window.", "defaultValue": "-90m"},
    {"name": "clickhouse_dsn", "type": "PX_STRING", "description": "forensic_db DSN: user:pass@host:port/db.", "defaultValue": "forensic_analyst:changeme-analyst@clickhouse-forensic-soc-db.clickhouse.svc.cluster.local:9000/forensic_db"},
    {"name": "namespace", "type": "PX_STRING", "description": "Focus one workload's namespace (substring). Empty = every flagged workload.", "defaultValue": ""}
  ],
  "globalFuncs": [
    {"outputName": "g_story", "func": {"name": "story", "args": [{"name": "start_time", "variable": "start_time"}, {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}, {"name": "namespace", "variable": "namespace"}]}},
    {"outputName": "g_beats", "func": {"name": "beats", "args": [{"name": "start_time", "variable": "start_time"}, {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}, {"name": "namespace", "variable": "namespace"}]}},
    {"outputName": "g_targets", "func": {"name": "targets", "args": [{"name": "start_time", "variable": "start_time"}, {"name": "clickhouse_dsn", "variable": "clickhouse_dsn"}, {"name": "namespace", "variable": "namespace"}]}}
  ],
  "widgets": [
    {"name": "Runtime breakout (workload -> off-profile targets; edge=kind; any signed-profile deviation)", "position": {"x": 0, "y": 0, "w": 12, "h": 6}, "globalFuncOutputName": "g_story", "displaySpec": {"@type": "types.px.dev/px.vispb.Graph", "adjacencyList": {"fromColumn": "from_entity", "toColumn": "to_entity"}, "edgeLabelColumn": "kind", "edgeHoverInfo": ["namespace", "rule", "kind", "events", "sev"], "edgeLength": 450}},
    {"name": "Attack beats (namespace x kind x rule)", "position": {"x": 0, "y": 6, "w": 6, "h": 4}, "globalFuncOutputName": "g_beats", "displaySpec": {"@type": "types.px.dev/px.vispb.Table"}},
    {"name": "Targets touched off-profile", "position": {"x": 6, "y": 6, "w": 6, "h": 4}, "globalFuncOutputName": "g_targets", "displaySpec": {"@type": "types.px.dev/px.vispb.Table"}}
  ]
}
