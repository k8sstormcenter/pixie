''' WebSocket Data Tracer

This script traces WebSocket frames on the cluster, including exec, attach and
port-forward sessions served by the API server and the kubelet.
'''
import px


def websocket_data(start_time: str, endpoint_filter: str, kind_filter: str, num_head: int):
    df = px.DataFrame(table='websocket_events', start_time=start_time)
    df.node = px._exec_hostname()
    df.pod = df.ctx['pod']
    df.endpoint = px.select(df.pod != '', df.pod, df.node)
    df = df[px.contains(df.endpoint, endpoint_filter)]
    df = df[px.contains(df.kind, kind_filter)]
    df = df.head(num_head)

    df.role = px.select(df.trace_role == 2, 'server', 'client')
    df.sent_by = px.select(df.direction == 1, 'client', 'server')
    df.frame = px.select(df.opcode == 1, 'text',
                         px.select(df.opcode == 2, 'binary',
                                   px.select(df.opcode == 8, 'close',
                                             px.select(df.opcode == 9, 'ping',
                                                       px.select(df.opcode == 10, 'pong',
                                                                 px.select(df.opcode == 0, 'continuation',
                                                                           px.itoa(df.opcode)))))))
    df.peer_pod = px.pod_id_to_pod_name(px.ip_to_pod_id(df.remote_addr))
    df.peer = px.select(df.peer_pod != '', df.peer_pod, df.remote_addr)

    df = df['time_', 'endpoint', 'local_port', 'role', 'peer', 'encrypted', 'subprotocol', 'kind',
            'sent_by', 'frame', 'payload', 'payload_size', 'output', 'output_size']
    return df


def websocket_summary(start_time: str, endpoint_filter: str, kind_filter: str):
    df = px.DataFrame(table='websocket_events', start_time=start_time)
    df.node = px._exec_hostname()
    df.pod = df.ctx['pod']
    df.endpoint = px.select(df.pod != '', df.pod, df.node)
    df = df[px.contains(df.endpoint, endpoint_filter)]
    df = df[px.contains(df.kind, kind_filter)]
    df.role = px.select(df.trace_role == 2, 'server', 'client')
    df = df.groupby(['endpoint', 'local_port', 'role', 'subprotocol', 'kind', 'encrypted']).agg(
        frames=('time_', px.count),
        payload_bytes=('payload_size', px.sum),
        output_bytes=('output_size', px.sum),
        last_seen=('time_', px.max),
    )
    return df
