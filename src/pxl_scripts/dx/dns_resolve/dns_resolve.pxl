# SOC DNS resolution reconstruction — works only with ClickHouse enabled.

import px


def dns_graph(start_time: str, clickhouse_dsn: str, order_id: str):
    # Every DNS event with a non-empty resp_body in the order's ±window, exploded
    # into resolution edges by the dx_dns_resolve view (querier->resolver, then the
    # answer tree name->CNAME and name->A). Time-windowed, NOT edge-linked: the
    # resolution runs on coredns / cluster-DNS, not the attacked pod, so the join is
    # on the order window (dx_orders_win.lo/hi), not on unique_id. The k=1 cross
    # join pairs the single window row with every DNS edge, then filters by time.
    win = px.DataFrame('dx_orders_win', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    win = win[win.order_id == order_id]
    win = win[['lo', 'hi']]
    win.k = 1
    d = px.DataFrame('dx_dns_resolve', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    d.k = 1
    d = d.merge(win, how='inner', left_on=['k'], right_on=['k'], suffixes=['', '_w'])
    d = d[d.event_time >= d.lo]
    d = d[d.event_time <= d.hi]
    d.from_entity = d.from_node
    d.to_entity = d.to_node
    return d[['from_entity', 'to_entity', 'edge_label', 'kind']]
