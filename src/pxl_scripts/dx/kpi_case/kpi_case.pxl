import px


def _cases(start_time: str, clickhouse_dsn: str, table: str, pod: str, kpi_version: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df = df[px.contains(df.pod, pod)]
    df = df[px.contains(df.kpi_version, kpi_version)]
    return df


def cases(start_time: str, clickhouse_dsn: str, table: str, pod: str, kpi_version: str):
    df = _cases(start_time, clickhouse_dsn, table, pod, kpi_version)
    df.pod_name = px.script_reference(px.Pod(df.pod), 'dx/kpi_proof', {
        'start_time': start_time,
        'attack_pods': df.pod,
        'pod': df.pod,
    })
    df.alert = px.select(df.alert_rule == '', 'no alert — scored on evidence',
                         df.alert_rule + ' ' + df.alert_text)
    df.alert_at = px.select(df.alert_ts == 0, px.int64_to_time(df.scored_at),
                            px.int64_to_time(df.alert_ts))
    df.scored = px.int64_to_time(df.scored_at)
    return df[['pod_name', 'suspicion', 'alert', 'alert_at', 'evidence', 'evidence_rows',
               'verdict', 'proof_source', 'parts_proven', 'class', 'kpi_version', 'scored',
               'order_id']]


def by_suspicion(start_time: str, clickhouse_dsn: str, table: str, pod: str, kpi_version: str):
    df = _cases(start_time, clickhouse_dsn, table, pod, kpi_version)
    df.is_malicious = px.select(df.verdict == 'malicious', 1, 0)
    df.is_gap = px.select(df.verdict == 'gap', 1, 0)
    df.is_benign = px.select(df.verdict == 'benign', 1, 0)
    df.has_alert = px.select(df.alert_rule == '', 0, 1)
    return df.groupby(['suspicion', 'kpi_version']).agg(
        cases=('pod', px.count),
        malicious=('is_malicious', px.sum),
        gap=('is_gap', px.sum),
        benign=('is_benign', px.sum),
        with_alert=('has_alert', px.sum),
        evidence_rows=('evidence_rows', px.sum),
        last_scored=('event_time', px.max),
    )


def suites(start_time: str, clickhouse_dsn: str, table: str):
    df = px.DataFrame(table, clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    df.is_malicious = px.select(df.verdict == 'malicious', 1, 0)
    return df.groupby(['kpi_version', 'suite']).agg(
        cases=('pod', px.count),
        malicious=('is_malicious', px.sum),
        first_scored=('event_time', px.min),
        last_scored=('event_time', px.max),
    )
