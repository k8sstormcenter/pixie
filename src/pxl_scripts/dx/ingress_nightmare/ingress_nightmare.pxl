# IngressNightmare (CVE-2025-1974) runtime-deviation story — ClickHouse only.
#
# One breakout, seen against a vendor-SIGNED ContainerProfile: the ingress-nginx
# controller pod fans out to the file/network targets node-agent flagged. Reads
# dx_ingress_story (a UNION-free view over kubescape_logs: pod -> target, kind,
# sev). kind encodes the beat — proc-read/libload = the /proc shared-lib trick,
# nginx-cfg = injected config, token-read = SA-cred theft, ingress = R0012.

import px


def story(start_time: str, clickhouse_dsn: str):
    e = px.DataFrame('dx_ingress_story', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    g = e.groupby(['from_node', 'to_node', 'kind', 'rule']).agg(
        events=('sev', px.count), sev=('sev', px.max))
    g.from_entity = g.from_node
    g.to_entity = g.to_node
    return g[['from_entity', 'to_entity', 'kind', 'rule', 'events', 'sev']]


def beats(start_time: str, clickhouse_dsn: str):
    # The attack beats, most-hit first: what the controller touched off-profile.
    e = px.DataFrame('dx_ingress_story', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    s = e.groupby(['kind', 'rule']).agg(events=('sev', px.count), sev=('sev', px.max))
    return s[['kind', 'rule', 'sev', 'events']]


def targets(start_time: str, clickhouse_dsn: str):
    e = px.DataFrame('dx_ingress_story', clickhouse_dsn=clickhouse_dsn, start_time=start_time)
    s = e.groupby(['kind', 'to_node']).agg(events=('sev', px.count))
    return s[['kind', 'to_node', 'events']]
