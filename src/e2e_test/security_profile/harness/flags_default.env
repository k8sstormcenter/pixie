# Default Pixie PEM env — no overrides. Documented for completeness so
# the diff against the other profiles is obvious.
PX_STIRLING_ENABLE_DNS_TRACING=1               # default On
PL_TABLE_STORE_DATA_LIMIT_MB=1280              # default (1024 + 256)
PL_TABLE_STORE_HTTP_EVENTS_PERCENT=40          # default
